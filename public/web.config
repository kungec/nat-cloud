<?xml version="1.0" encoding="UTF-8"?>
<!--
  NAT Cloud - IIS 配置（本文件位于 public/ 运行目录）
  要求：IIS 10（Windows Server 2016 自带）+ URL Rewrite 模块 2.0 + PHP 7.4+（CGI/FastCGI）
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- 伪静态：非物理文件/目录的请求全部进入前端控制器 -->
    <rewrite>
      <rules>
        <rule name="NATCloud Front Controller" stopProcessing="true">
          <match url=".*" ignoreCase="false" />
          <conditions logicalGrouping="matchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <!-- 敏感文件双保险（.env/install.lock 位于运行目录上层，正常不可达） -->
    <security>
      <requestFiltering>
        <files>
          <add file=".env" />
          <add file="install.lock" />
        </files>
        <hiddenSegments>
          <add segment="app" />
          <add segment="cron" />
          <add segment="install" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- 静态资源缓存 -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlCustom="public" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
  </system.webServer>
</configuration>
